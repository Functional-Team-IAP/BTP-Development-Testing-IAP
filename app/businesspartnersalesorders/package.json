{
  "name": "businesspartnersalesorders",
  "version": "1.0.0",
  "description": "Fiori Elements List Report for Business Partner Sales Orders",
  "private": true,
  "devDependencies": {
    "@ui5/cli": "^3",
    "@sap/ux-ui5-tooling": "^1",
    "@sap/ux-specification": "^1.120.0"
  },
  "scripts": {
    "start": "fiori run --open \"index.html?sap-ui-xx-viewCache=false\"",
    "start-mock": "fiori run --config ./ui5-mock.yaml --open \"index.html?sap-ui-xx-viewCache=false\"",
    "build": "ui5 build --clean-dest --config ui5.yaml --dest dist",
    "deploy-config": "fiori add deploy-config",
    "unit-test": "fiori run --open \"test/unit/unitTests.qunit.html\""
  },
  "sapuxLayer": "CUSTOMER_BASE",
  "ui5": { "dependencies": [ "@sap/ux-ui5-tooling" ] }
}
