{
  "_version": "1.65.0",
  "sap.app": {
    "id": "iap.sales.businesspartnersalesorders",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.13.4",
      "toolsId": "iap-bp-sales-orders"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sales/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "BusinessPartnerSalesOrders-display": {
          "semanticObject": "BusinessPartnerSalesOrders",
          "action": "display",
          "title": "{{flpTitle}}",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": { "icon": "sap-icon://table-view" },
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.140.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "iap.sales.businesspartnersalesorders.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": { "css": [] },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "BusinessPartnerSalesOrdersList",
          "target": "BusinessPartnerSalesOrdersList"
        }
      ],
      "targets": {
        "BusinessPartnerSalesOrdersList": {
          "type": "Component",
          "id": "BusinessPartnerSalesOrdersList",
          "name": "sap.fe.templates.AnalyticalListPage",
          "options": {
            "settings": {
              "contextPath": "/BusinessPartnerSalesOrders",
              "variantManagement": "None",
              "initialLoad": "Enabled",
              "defaultTemplateAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#default",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.Chart": {
                  "chartSettings": {
                    "personalization": true
                  }
                },
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "AnalyticalTable",
                    "personalization": {
                      "sort": true,
                      "column": true,
                      "filter": true,
                      "group": true,
                      "aggregate": true
                    },
                    "selectAll": true,
                    "selectionMode": "Multi"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
