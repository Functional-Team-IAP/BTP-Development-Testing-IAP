{
  "_version": "1.65.0",
  "sap.app": {
    "id": "iap.sales.businesspartnersalesorders",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "sourceTemplate": {
      "id": "ui5template.smartTemplate",
      "version": "1.40.12"
    },
    "dataSources": {
      "mainService": {
        "uri": "/v2/sales/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "BusinessPartnerSalesOrders-display": {
          "semanticObject": "BusinessPartnerSalesOrders",
          "action": "display",
          "title": "{{flpTitle}}",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": { "icon": "sap-icon://table-view" },
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ushell": {},
        "sap.ui.core": {},
        "sap.ui.generic.app": {},
        "sap.suite.ui.generic.template": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "iap.sales.businesspartnersalesorders.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "metadataUrlParams": { "sap-value-list": "none" },
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline"
        }
      }
    },
    "resources": { "css": [] }
  },
  "sap.ui.generic.app": {
    "_version": "1.3.0",
    "settings": {
      "forceGlobalRefresh": false,
      "objectPageHeaderType": "Dynamic",
      "considerAnalyticalParameters": true
    },
    "pages": [
      {
        "entitySet": "BusinessPartnerSalesOrders",
        "component": {
          "name": "sap.suite.ui.generic.template.ListReport",
          "list": true,
          "settings": {
            "tableType": "GridTable",
            "multiSelect": true,
            "condensedTableLayout": true,
            "smartVariantManagement": false,
            "gridTable": {
              "selectionMode": "MultiToggle",
              "enableColumnReordering": true,
              "enableSelectAll": true
            }
          }
        }
      }
    ]
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
